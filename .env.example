HOST=127.0.0.1
PORT=8787
APP_SECRET=replace-with-a-long-random-local-secret
AXIOM_DATA_DIR=.axiom-data
AXIOM_SECRET_FILE=.axiom-data/.axiom-secret
AXIOM_VAULT_FILE=.axiom-data/credentials.vault.json
DB_MODE=mysql
MYSQL_URL=mysql://root:password@127.0.0.1:3306/axiom_agent
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=axiom_agent
BROWSER_ALLOWED_DOMAINS=localhost,127.0.0.1,demo.exchange.local,smyw.haohandahan.cn
SHELL_ALLOWED_COMMANDS=pwd,ls,rg,node,npm,docker,bash,sh
SHELL_ALLOWED_CWDS=.
DESKTOP_ALLOWED_APPS=Calculator,TextEdit,notepad
DESKTOP_ALLOWED_PATHS=/Applications
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-use
ADMIN_SESSION_TTL_SEC=28800
DESKTOP_USERNAME=operator
DESKTOP_PASSWORD=change-me-desktop
DESKTOP_DISPLAY_NAME=观察员
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DeepSeek env is a first-run seed only. Runtime keys are encrypted in MySQL providers.encrypted_key.
# Optional polling override: 1000-120000 ms. Empty uses timeframe defaults.
MONITOR_POLL_INTERVAL_MS=
# Collected read-only K-line periods. Model input is layered separately:
# last 1 hour as 1m, then 1h until yesterday 00:00 Asia/Shanghai, then 1d through last month, then 1mo.
HAOHAN_ANALYSIS_TIMEFRAMES=1m,1h,1d,1mo
HAOHAN_KLINE_COUNT=2000
# LIVE tasks submit only after the desktop confirm dialog. Set 0 to keep confirm-only (no live click).
AXIOM_TRADING_ENABLED=1
CORS_ALLOWED_ORIGINS=
# Set to 1 only for an explicitly disposable local demo when the configured DB is unavailable.
ALLOW_MEMORY_FALLBACK=0
