# v1.0 桌面版无需 .env，且不会读取旧服务器的 .env。
# 可选开发选项通过启动进程的环境变量传入，例如：
# AXIOM_TRADING_ENABLED=0 npm run dev
# AXIOM_USER_DATA_DIR=/absolute/path/to/test-profile npm start
# 以下值供手工设置进程环境时参考；无需配置数据库或平台账号。
AXIOM_TRADING_ENABLED=1
BROWSER_ALLOWED_DOMAINS=localhost,127.0.0.1,smyw.haohandahan.cn
MONITOR_POLL_INTERVAL_MS=
HAOHAN_ANALYSIS_TIMEFRAMES=1m,1h,1d,1mo
HAOHAN_KLINE_COUNT=2000
